{
  "expo": {
    "name": "closet-app",
    "slug": "closet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "closetapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.closetapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "服の写真を撮るためにカメラへのアクセスを許可してください",
        "NSPhotoLibraryUsageDescription": "服の写真をアルバムから選ぶためにアクセスを許可してください",
        "NSPhotoLibraryAddUsageDescription": "撮影した写真を保存するためにアルバムへのアクセスを許可してください"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.anonymous.closetapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "服の写真を撮るためにカメラへのアクセスを許可してください"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "服の写真をアルバムから選ぶためにアクセスを許可してください",
          "cameraPermission": "服の写真を撮るためにカメラへのアクセスを許可してください"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
